# Override some defaults so Classic BT OPP client is enabled
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_OPP_ENABLED=y
CONFIG_BT_OPP_SERVER_ENABLED=n
CONFIG_BT_OPP_CLIENT_ENABLED=y
