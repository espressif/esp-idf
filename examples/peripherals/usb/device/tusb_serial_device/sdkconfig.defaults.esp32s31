# Enable automatic light sleep and peripheral power-down support.
CONFIG_PM_ENABLE=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Let esp_tinyusb prepare and restore the USB PHY around light sleep.
CONFIG_ESP_SLEEP_EVENT_CALLBACKS=y
CONFIG_TINYUSB_USB_OTG_WAKEUP=y
CONFIG_TINYUSB_PM=y
