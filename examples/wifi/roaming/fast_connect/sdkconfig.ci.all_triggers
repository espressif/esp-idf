# Fast connect beside every other trigger and method: low RSSI, periodic scans, BTM, 11k and the blacklist
CONFIG_ESP_WIFI_ROAMING_LOW_RSSI_ROAMING=y
CONFIG_ESP_WIFI_ROAMING_PERIODIC_SCAN_MONITOR=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_WNM_SUPPORT=y
CONFIG_ESP_WIFI_RRM_SUPPORT=y
CONFIG_ESP_WIFI_SCAN_CACHE=y
CONFIG_ESP_WIFI_ROAMING_NETWORK_ASSISTED_ROAM=y
CONFIG_ESP_WIFI_ROAMING_PERIODIC_RRM_MONITORING=y
CONFIG_ESP_WIFI_ROAMING_BSSID_BLACKLIST=y
CONFIG_ESP_WIFI_ROAMING_AUTO_BLACKLISTING=y
CONFIG_EXAMPLE_BUSY_AFTER_IP_MS=3000
