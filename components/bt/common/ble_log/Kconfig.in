config BLE_LOG_ENABLED
    bool "Enable BT Log Async Output (Dev Only)"
    select BLE_COMPRESSED_LOG_ENABLE
    select ESP_TIMER_IN_IRAM
    default n
    help
        Enable BT Log Async Output

if BLE_LOG_ENABLED
    config BLE_LOG_POOL_TRANS_CNT
        int "Number of transport buffers in the unified pool"
        range 2 32
        default 8
        help
            Total number of transports shared by ordinary, Link Layer, ISR,
            and critical-section log writers. Availability is represented by
            32-bit bitmaps, so the maximum is 32.

    config BLE_LOG_POOL_NON_YIELD_RESERVE_CNT
        int "Transport buffers reserved for non-yieldable contexts"
        range 1 31
        default 1
        help
            Buffers that ordinary task writers cannot consume. ISR and
            critical-section writers try the shared region first, then this
            reserve. The value must remain below BLE_LOG_POOL_TRANS_CNT.

    config BLE_LOG_POOL_TRANS_SIZE
        int "Per-transport buffer size (bytes)"
        range 640 10240
        default 640
        help
            Size of every unified-pool transport. One complete frame must fit
            in one transport. SPI builds require a multiple of four so they
            can append peripheral-only zero padding to each logical frame.

    config BLE_LOG_POOL_WAIT_TIMEOUT_MS
        int "Total wait budget for one pool acquire (ms)"
        depends on BLE_LOG_PRPH_USB || BLE_LOG_PRPH_TEST
        range -1 1000
        default 10 if BLE_LOG_PRPH_USB
        default -1
        help
            Bounded total wait for a single transport acquire by an ordinary
            yieldable task. 0 fails immediately when the pool is busy; -1
            keeps the historical infinite wait; positive values are rounded
            up to FreeRTOS ticks and cap the total wait across all wakeups
            of one acquire (the budget is never reset by a wake).

            Only visible for USB and test builds. Production SPI/UART
            builds keep the infinite wait (the symbol stays undefined and
            the code falls back to portMAX_DELAY). 10 ms is an initial
            test value for USB builds only; the final default must be
            measured on the target DMA path.

    config BLE_LOG_TASK_ID_MAX
        int "Maximum number of distinct logging tasks"
        range 2 32
        default 16
        help
            Size of the task-id registry (protocol v8). Every ENCODE record
            carries the one-byte id of the task that formatted it; the
            registry maps task names to those stable ids. One binding record
            per registered entry is broadcast as an INTERNAL frame on every
            periodic snapshot window, so a receiver that missed or lost a
            binding converges on the next window. A task that starts logging
            after the registry is full falls back to the unknown id (0xFF)
            and its records are still emitted.

            RAM cost is 16 bytes per entry (256 bytes at the default 16)
            plus one dedicated binding transport (320 bytes at 16 entries,
            624 at 32; the broadcast frame must fit in one transport).

    config BLE_LOG_IS_ESP_CONTROLLER
        bool "Current BLE Controller is ESP BLE Controller"
        depends on BT_CONTROLLER_ENABLED
        depends on SOC_ESP_NIMBLE_CONTROLLER
        default y
        select BT_LE_CONTROLLER_LOG_ENABLED
        select BLE_LOG_LL_ENABLED
        help
            Current BLE Controller is ESP BLE Controller

    config BLE_LOG_IS_ESP_LEGACY_CONTROLLER
        bool "Current BLE Controller is ESP BLE Legacy Controller"
        depends on BT_CONTROLLER_ENABLED
        depends on !SOC_ESP_NIMBLE_CONTROLLER
        default y
        help
            Current BLE Controller is ESP BLE Legacy Controller

    config BLE_LOG_LL_ENABLED
        bool "Enable BLE Log for Link Layer"
        depends on BT_CONTROLLER_ENABLED
        default y if BLE_LOG_IS_ESP_LEGACY_CONTROLLER
        default n
        help
            Enable BLE Log for Link Layer

    config BLE_LOG_HOST_LOG
        bool "Enable BLE Log for Host"
        depends on BT_BLUEDROID_ENABLED || BT_NIMBLE_ENABLED
        default y
        help
            Enable BLE Log for the Host stack (Bluedroid or NimBLE).

            When enabled, host-side log statements are routed through the
            BLE Log async output transport instead of (or in addition to)
            the standard UART logging path. Disable this option to keep
            BLE Log enabled for the controller/link layer only.

    config BLE_LOG_HCI_LOG_ENABLED
        bool "Enable BLE HCI Logging"
        default y
        help
            Enable HCI packet logging. Bluedroid and legacy VHCI NimBLE
            capture on the Host side and suppress duplicate Controller
            HCI records. Other configurations, including non-legacy
            NimBLE, retain Controller HCI records through the LL callback
            and require BLE_LOG_LL_ENABLED. Disabling this option
            suppresses HCI records from both capture paths.

    config BLE_LOG_TS_SYNC_TOGGLE_IO_ENABLED
        bool "Toggle a GPIO on every BLE Log TS sync sample"
        default n
        help
            Every periodic Internal Snapshot samples the link-layer, ESP and
            OS clocks regardless of this option. Enable this option to build
            the GPIO toggle used by external logic analyzers. It starts
            disabled and low; ble_log_ts_sync_io_toggle_enable controls its
            edges without stopping periodic snapshots.

    if BLE_LOG_TS_SYNC_TOGGLE_IO_ENABLED
        config BLE_LOG_SYNC_IO_NUM
            int "GPIO number for Timestamp Synchronization (TS) toggle output"
            default 0
            help
                GPIO number for TS toggle output
    endif

    choice BLE_LOG_PRPH_CHOICE
        prompt "BLE Log peripheral choice"
        default BLE_LOG_PRPH_UART_DMA if SOC_UHCI_SUPPORTED
        default BLE_LOG_PRPH_DUMMY
        help
            Choose BLE Log peripheral

        config BLE_LOG_PRPH_DUMMY
            bool "Dummy transport"
            help
                Dummy transport (dump only)

        config BLE_LOG_PRPH_TEST
            bool "Test only transport"
            help
                Test transport that models DMA ownership and optional
                link-rate backpressure. Intended for the BLE Log test apps
                only: outside them nothing drains the transmitted buffers,
                so selecting this transport in a production build stalls
                log output. The BLE Log test apps select it through their
                sdkconfig.defaults.

        config BLE_LOG_PRPH_SPI_MASTER_DMA
            bool "Utilize SPI master DMA driver as transport"
            depends on SOC_GPSPI_SUPPORTED
            help
                Utilize SPI master DMA driver as transport

        config BLE_LOG_PRPH_SPI_MASTER_HD
            bool "Utilize SPI master HD DMA protocol as transport"
            depends on SOC_GPSPI_SUPPORTED && SOC_SPI_SUPPORT_SLAVE_HD_VER2
            help
                Utilize SPI master HD DMA protocol as transport

        config BLE_LOG_PRPH_UART_DMA
            bool "Utilize UART DMA driver as transport"
            depends on SOC_UHCI_SUPPORTED
            help
                Utilize UART DMA driver as transport

        config BLE_LOG_PRPH_USB
            bool "Utilize USB OTG device as transport (TinyUSB CDC-ACM)"
            depends on SOC_USB_OTG_SUPPORTED
            help
                Copy each sealed transport into the TinyUSB CDC TX FIFO
                and recycle immediately. A transport that does not fit is
                dropped with a warning. The USB device starts and stops
                with ble_log_init/deinit. Works on any target with a
                USB OTG peripheral, Full-Speed or High-Speed.

                Requires espressif/esp_tinyusb in the project manifest
                and CONFIG_TINYUSB_CDC_ENABLED. Copy
                idf_component_usb.template.yml from the BLE Log component
                directory into the application's main/ directory, then
                run idf.py reconfigure. See the "USB transport" section
                in the BLE Log README for the full setup and buffer
                requirements.
    endchoice

    if BLE_LOG_PRPH_SPI_MASTER_DMA || BLE_LOG_PRPH_SPI_MASTER_HD
        config BLE_LOG_PRPH_SPI_MASTER_DMA_MOSI_IO_NUM
            int "GPIO number of MOSI port for SPI master transport (-1: native SPI2 IOMUX)"
            default -1
            help
                GPIO number of MOSI port for SPI master transport. Set to -1
                to use the target's native SPI2 IOMUX pin.

        config BLE_LOG_PRPH_SPI_MASTER_DMA_SCLK_IO_NUM
            int "GPIO number of SCLK port for SPI master transport (-1: native SPI2 IOMUX)"
            default -1
            help
                GPIO number of SCLK port for SPI master transport. Set to -1
                to use the target's native SPI2 IOMUX pin.

        config BLE_LOG_PRPH_SPI_MASTER_DMA_CS_IO_NUM
            int "GPIO number of CS port for SPI master transport (-1: native SPI2 IOMUX)"
            default -1
            help
                GPIO number of CS port for SPI master transport. Set to -1 to
                use the target's native SPI2 IOMUX pin.
    endif

    if BLE_LOG_PRPH_UART_DMA
        config BLE_LOG_PRPH_UART_DMA_PORT
            int "UART port number for UART DMA transport"
            default 0
            help
                UART port number for UART DMA

        config BLE_LOG_PRPH_UART_DMA_BAUD_RATE
            int "Baud rate of UART port for UART DMA transport"
            default 3000000
            help
                Determine the baud rate of UART port

        config BLE_LOG_PRPH_UART_DMA_TX_IO_NUM
            int "GPIO number for UART TX"
            default 0
            help
                GPIO number for UART TX
    endif

    if BLE_LOG_PRPH_USB
        config BLE_LOG_RT_TASK_STACK_SIZE
            int "BLE Log dispatch task stack size (bytes)"
            range 1024 8192
            default 2048 if IDF_TARGET_ARCH_XTENSA
            default 1024
            help
                Stack for the dedicated runtime dispatch task. USB builds
                drain the transport queue from this task instead of the 1 ms
                deferred esp_timer batch, so the throughput is not capped by
                the defer cadence. The dispatch call chain was measured at
                roughly 2 KB on Xtensa (register-window calling convention)
                and 1 KB on RISC-V.

        config BLE_LOG_USB_CDC_TX_BUFSIZE
            int "CDC ACM TX FIFO size (bytes)"
            range 640 10240
            default 2048
            help
                TinyUSB CDC software TX FIFO. This is the absorption
                buffer between the BLE Log transports and the USB
                endpoint: a sealed transport is copied here whole or
                dropped. Must be at least BLE_LOG_POOL_TRANS_SIZE.
                Also set CONFIG_TINYUSB_CDC_TX_BUFSIZE to this value.

                Measured on ESP32-S31: 1024 costs about 5% of the
                delivered throughput (the FIFO stalls the producer
                sooner), while 4096 gains nothing over 2048. 2048 (three
                transports of headroom) is the knee; only lower it to
                trade throughput for 1 KB of RAM.

        config BLE_LOG_USB_CDC_EP_BUFSIZE
            int "CDC bulk endpoint buffer size (bytes)"
            range 64 8192
            default 512
            help
                TinyUSB CDC endpoint buffer, and the transfer length of
                one bulk IN submission (CFG_TUD_CDC_TX_EPSIZE): each
                submitted transfer carries at most this many bytes. Also
                set CONFIG_TINYUSB_CDC_EP_BUFSIZE to this value and
                CONFIG_TINYUSB_CDC_RX_BUFSIZE to at least this value
                (TinyUSB warns if RX is smaller). Static RAM cost is
                twice this value (one IN and one OUT endpoint buffer).

                The bulk maximum packet size in the device descriptor is
                fixed at 512 on High-Speed and 64 on Full-Speed and does
                not follow this option, so the best value depends on the
                target speed:

                - High-Speed (e.g. ESP32-S31): keep 512, where one
                  submission is exactly one packet. 1024 and 2048 deliver
                  about 9% less and cost roughly 1.5 KB / 4.5 KB more RAM.
                - Full-Speed (e.g. ESP32-S2/S3): raise it to 1024. The
                  64-byte packet size is the worst case, 0.58 MiB/s
                  against 1.03 MiB/s at 1024; 2048 adds only 2% for 3 KB
                  more RAM.

                See the "USB transport" section of the BLE Log README for
                the measurement setup and the per-value numbers.
    endif

    menu "Settings of BLE Log Compression"
        source "$IDF_PATH/components/bt/common/ble_log/extension/log_compression/Kconfig.in"
    endmenu

    # Deprecated options -- retained for backward sdkconfig compatibility.
    # These symbols have no prompt so they never appear in menuconfig.
    config BLE_LOG_LBM_TRANS_SIZE
        int
        default 512

    config BLE_LOG_LBM_TRANS_BUF_SIZE
        int
        default 2048

    config BLE_LOG_LBM_ATOMIC_LOCK_TASK_CNT
        int
        default 2

    config BLE_LOG_LBM_ATOMIC_LOCK_ISR_CNT
        int
        default 1

    config BLE_LOG_LBM_LL_TRANS_BUF_SIZE
        int
        default 2048

    config BLE_LOG_LL_HCI_LOG_PAYLOAD_LEN_LIMIT_ENABLED
        bool
        default n

    config BLE_LOG_LL_HCI_LOG_PAYLOAD_LEN_LIMIT
        int
        depends on BLE_LOG_LL_HCI_LOG_PAYLOAD_LEN_LIMIT_ENABLED
        default 32

    config BLE_LOG_LBM_AUTO_FLUSH
        bool
        default n

    config BLE_LOG_ENH_STAT_ENABLED
        bool
        default y

    config BLE_LOG_PAYLOAD_CHECKSUM_ENABLED
        bool
        default y

    config BLE_LOG_LBM_LL_TRANS_SIZE
        int
        default 512

    config BLE_LOG_TASK_STACK_SIZE
        int
        default 1024 if IDF_TARGET_ARCH_RISCV
        default 2048 if IDF_TARGET_ARCH_XTENSA
        default 1024

    config BLE_LOG_TS_TRIGGER_TIMEOUT_MS
        int
        default 1000

    config BLE_LOG_TS_TRIGGER_CHOICE
        bool
        default y

    config BLE_LOG_TS_TRIGGER_ESP_TIMER
        bool
        default y

    config BLE_LOG_TS_TRIGGER_TASK_EVENT
        bool
        default n

    config BLE_LOG_TS_TRIGGER_ESP_TIMER_ISR_DISPATCH_METHOD
        bool
        default n

    # Deprecated: renamed to BLE_LOG_HCI_LOG_ENABLED. No prompt, so it
    # never appears in menuconfig; kept so sdkconfig files pinning the old
    # name keep Host side HCI logging enabled.
    config BLE_LOG_HOST_SIDE_HCI_LOG_ENABLED
        bool
        default n
        select BLE_LOG_HCI_LOG_ENABLED
endif

menu "Legacy SPI Log Output (Deprecated - use BT Log Async Output instead)"
    source "$IDF_PATH/components/bt/common/ble_log/deprecated/Kconfig.in"
endmenu
