# Secure Boot V2: RSA scheme
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_SIGNING_KEY="test_keys/secure_boot_signing_key_rsa_3072.pem"

# Bootloader OTA (recovery bootloader) + bootloader anti-rollback
CONFIG_BOOTLOADER_RECOVERY_ENABLE=y
CONFIG_BOOTLOADER_RECOVERY_OFFSET=0x3F0000
CONFIG_BOOTLOADER_ANTI_ROLLBACK_ENABLE=y

# TEE I/DRAM sizes (total TEE SRAM: 0xe800 = 58KB)
# 37KB
CONFIG_SECURE_TEE_IRAM_SIZE=0x9400
# 21KB
CONFIG_SECURE_TEE_DRAM_SIZE=0x5400
