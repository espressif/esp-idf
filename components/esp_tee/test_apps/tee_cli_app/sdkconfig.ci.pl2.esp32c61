# Secure Boot V2: ECDSA scheme
# NOTE: No RSA scheme on this target; ECDSA Secure Boot V2 is gated behind the insecure option
CONFIG_SECURE_BOOT_INSECURE=y
CONFIG_SECURE_BOOT_V2_FORCE_ENABLE_ECDSA=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_V2_SCHEME=y
CONFIG_SECURE_BOOT_SIGNING_KEY="test_keys/secure_boot_signing_key_ecdsa_p256.pem"

# Bootloader OTA (recovery bootloader) + bootloader anti-rollback
CONFIG_BOOTLOADER_RECOVERY_ENABLE=y
CONFIG_BOOTLOADER_RECOVERY_OFFSET=0x3F0000
CONFIG_BOOTLOADER_ANTI_ROLLBACK_ENABLE=y

# TEE I/DRAM sizes (total TEE SRAM: 0xd600 = 53.5KB)
# 33KB
CONFIG_SECURE_TEE_IRAM_SIZE=0x8400
# 20.5KB
CONFIG_SECURE_TEE_DRAM_SIZE=0x5200
