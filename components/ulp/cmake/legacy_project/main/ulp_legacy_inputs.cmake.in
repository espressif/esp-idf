set(ULP_LEGACY_SOURCES
@ULP_LEGACY_SOURCES@
)

set(ULP_LEGACY_INCLUDE_DIR_CANDIDATES
@ULP_LEGACY_INCLUDE_DIR_CANDIDATES@
)

set(ULP_LEGACY_PARENT_SDKCONFIG_HEADER [=[@ULP_LEGACY_PARENT_SDKCONFIG_HEADER@]=])

set(ULP_LEGACY_INCLUDE_DIRS)
foreach(include IN LISTS ULP_LEGACY_INCLUDE_DIR_CANDIDATES)
    if(IS_DIRECTORY "${include}")
        list(APPEND ULP_LEGACY_INCLUDE_DIRS "${include}")
    endif()
endforeach()
