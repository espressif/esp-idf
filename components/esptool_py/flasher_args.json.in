{
    "write_flash_args" : [ "--flash-mode", "${ESPFLASHMODE}",
                           "--flash-size", "${ESPFLASHSIZE}",
                           "--flash-freq", "${ESPFLASHFREQ}" ],
    "flash_settings" : {
        "flash_mode": "${ESPFLASHMODE}",
        "flash_size": "${ESPFLASHSIZE}",
        "flash_freq": "${ESPFLASHFREQ}"
    },
    "flash_files" : {
        $<JOIN:${FLASHER_ARGS_FILES},,
        >
    },
    $<JOIN:${FLASHER_ARGS_ENTRIES},,
    >$<$<BOOL:${FLASHER_ARGS_ENTRIES}>:,>
    "extra_esptool_args" : {
        "after"  : "${ESPTOOLPY_AFTER}",
        "before" : "${ESPTOOLPY_BEFORE}",
        "stub"   : ${ESPTOOLPY_WITH_STUB},
        "chip"   : "${ESPTOOLPY_CHIP}"
    }
}
