# Automatic light sleep with the TOP (peripheral) power domain and the Wi-Fi MAC/BB
# powered down, so the peripheral and modem retention code is tracked by size metrics
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_PHY_MAC_BB_PD=y
